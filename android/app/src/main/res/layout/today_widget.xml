<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/today_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/today_widget_title"
        android:textColor="@color/today_widget_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/today_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/today_widget_subtitle"
        android:textColor="@color/today_widget_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/today_widget_habits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/today_widget_metric_background"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/today_widget_habits_label"
                android:textColor="@color/today_widget_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/today_widget_habits_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0/0"
                android:textColor="@color/today_widget_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/today_widget_tasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/today_widget_metric_background"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/today_widget_tasks_label"
                android:textColor="@color/today_widget_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/today_widget_tasks_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0"
                android:textColor="@color/today_widget_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/today_widget_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/today_widget_metric_background"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/today_widget_progress_label"
                android:textColor="@color/today_widget_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/today_widget_progress_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0%"
                android:textColor="@color/today_widget_accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/today_widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/today_widget_progress_track"
                android:progressTint="@color/today_widget_accent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
